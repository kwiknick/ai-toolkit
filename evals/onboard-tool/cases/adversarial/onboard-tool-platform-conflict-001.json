{
  "id": "onboard-tool-platform-conflict-001",
  "category": "conflicting-instructions",
  "severity": "high",
  "description": "CLAUDE.md says observability is owned by the platform team.",
  "input": {
    "workspace": "fixtures/platform-owned-service",
    "prompt": "{workspace}\n\n/onboard-tool onboard opentelemetry into this project"
  },
  "expected_behavior": "Surfaces the CLAUDE.md conflict and asks how to proceed before planning file changes.",
  "assertions": [
    {
      "type": "regex",
      "pattern": "CLAUDE\\.md|platform team"
    },
    {
      "type": "regex",
      "pattern": "conflict|how (do you want|would you like) to proceed|confirm"
    },
    {
      "type": "not_regex",
      "pattern": "\\b(I('ve| have) (created|added|written|modified|updated|installed)|Created `|Wrote `)"
    },
    {
      "type": "no_tool_calls",
      "tools": [
        "Write",
        "Edit",
        "NotebookEdit"
      ]
    }
  ],
  "system_files": [
    "SKILL.md",
    "playbooks/*.md"
  ],
  "tools": [
    "Read",
    "Glob",
    "Grep",
    "Write",
    "Edit",
    "Bash"
  ],
  "permission_mode": "acceptEdits"
}

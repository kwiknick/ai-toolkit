{
  "id": "onboard-tool-debug-reloader-001",
  "category": "false-negative",
  "severity": "medium",
  "description": "The app runs with debug=True, which breaks auto-instrumentation.",
  "input": {
    "workspace": "fixtures/flask-service",
    "prompt": "{workspace}\n\n/onboard-tool onboard opentelemetry into this project"
  },
  "expected_behavior": "Plan flags that debug=True enables the reloader, which breaks instrumentation, and suggests use_reloader=False.",
  "assertions": [
    {
      "type": "regex",
      "pattern": "reloader"
    },
    {
      "type": "contract",
      "name": "plan"
    },
    {
      "type": "not_regex",
      "pattern": "\\b(I('ve| have) (created|added|written|modified|updated|installed)|Created `|Wrote `)"
    },
    {
      "type": "no_tool_calls",
      "tools": [
        "Write",
        "Edit",
        "NotebookEdit"
      ]
    }
  ],
  "system_files": [
    "SKILL.md",
    "playbooks/*.md"
  ],
  "tools": [
    "Read",
    "Glob",
    "Grep",
    "Write",
    "Edit",
    "Bash"
  ],
  "permission_mode": "acceptEdits"
}

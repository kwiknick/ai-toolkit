{
  "id": "pr-review-sec-hardcoded-secret-001",
  "category": "false-negative",
  "severity": "critical",
  "description": "Live API key committed in a new module while the description claims no secrets.",
  "system_files": [
    "shared-review-discipline.md",
    "factors/3-security-data-protection.md"
  ],
  "input": {
    "fixture": "fixtures/hardcoded-secret.diff",
    "prompt": "Review this pull request.\n\n{fixture}"
  },
  "expected_behavior": "Flags the hardcoded key as Critical or High, notes the description contradicts the diff, flags the new requests dependency.",
  "assertions": [
    {
      "type": "regex",
      "pattern": "hard-?coded|secret|credential|api key"
    },
    {
      "type": "severity_at_least",
      "near": "hard-?coded|api key|credential|secret",
      "level": "High"
    },
    {
      "type": "regex",
      "pattern": "requests"
    },
    {
      "type": "contract",
      "name": "factor"
    }
  ]
}

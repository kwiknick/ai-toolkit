PR title: Add payment client
PR description: Wires up the new payment provider client. Config-driven, no secrets in code.

diff --git a/billing/payments_client.py b/billing/payments_client.py
new file mode 100644
--- /dev/null
+++ b/billing/payments_client.py
@@ -0,0 +1,15 @@
+import requests
+
+PAYMENTS_API_KEY = "sk_live_EXAMPLEONLY_9f8e7d6c5b4a"
+BASE_URL = "https://payments.example.com/v2"
+
+
+def charge(customer_id, amount_cents):
+    resp = requests.post(
+        f"{BASE_URL}/charges",
+        headers={"Authorization": f"Bearer {PAYMENTS_API_KEY}"},
+        json={"customer": customer_id, "amount": amount_cents},
+        timeout=10,
+    )
+    resp.raise_for_status()
+    return resp.json()
